{
  "name": "ai-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "build:widget": "vite build --config vite.widget.config.ts && node scripts/embed-widget.mjs",
    "build:host": "vite build --config vite.dev-host.config.ts",
    "build": "npm run build:web && npm run build:widget",
    "server": "tsx server/index.ts",
    "start": "npm run build:all && npm run server",
    "typecheck": "tsc --noEmit",
    "build:all": "npm run build && npm run build:host"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vercel/blob": "^2.9.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "22.x"
  }
}
